    <string name="cd_help">Help</string>
    <string name="dialog_help_title">Help &amp; Quick Guide</string>
    <string name="help_vol_keys_title">Hardware Volume Buttons</string>
    <string name="help_vol_keys_desc">Volume+ = Start All / Lap split for focused watch\nVolume- = Stop focused watch / Reset all when stopped</string>
    <string name="help_hardware_keys_title">Hardware Volume Buttons</string>
    <string name="help_hardware_keys_desc">Volume+ = Start All / Lap split for focused watch\nVolume- = Stop focused watch / Reset all when stopped</string>
    <string name="help_reset_title">Reset Button Controls</string>
    <string name="help_reset_desc">Short tap (&lt;0.5s): Resets display time to 0 and prepares a new run session (Run 1, Run 2, …).\nLong press (&gt;0.5s): Performs a complete wipe of all run sessions and lap history.</string>
    <string name="help_reset_button_title">Reset Button Controls</string>
    <string name="help_reset_button_desc">Short tap (&lt;0.5s): Resets display time to 0 and prepares a new run session (Run 1, Run 2, …).\nLong press (&gt;0.5s): Performs a complete wipe of all run sessions and lap history.</string>
    <string name="help_pace_trend_title">Pace Trend Indicators</string>
    <string name="help_pace_trend_desc">Green ▼ indicates a lap faster than the previous split, while Red ▲ indicates a slower lap.</string>
    <string name="help_roster_title">Saved Athlete Roster</string>
    <string name="help_roster_desc">Editing athlete names automatically saves them to your roster. In the Batch Add dialog, tick athlete names from the checklist to quickly create stopwatches for your team.</string>
    <string name="help_csv_title">Exporting &amp; CSV Spreadsheets</string>
    <string name="help_csv_desc">Share race results as plain text summaries for messaging apps or as .csv spreadsheet files for Excel and Google Sheets.</string>
    <string name="help_details_title">Detail View &amp; Export</string>
    <string name="help_details_desc">Tap info icon on any watch tile to view run session history and export individual results. Stopped stopwatches feature a \"Delete Runs\" button in the Detail View to clear history.</string>
    <string name="help_detail_view_title">Detail View &amp; Export</string>
    <string name="help_detail_view_desc">Tap info icon on any watch tile to view run session history and export individual results. Stopped stopwatches feature a \"Delete Runs\" button in the Detail View to clear history.</string>
    <string name="help_settings_title">Precision &amp; Display Settings</string>
    <string name="help_settings_desc">Configure separate running time vs result/lap precision, themes, text scaling, auto-sorting, Keep Screen Awake, and language settings.</string>
    <string name="help_session_naming_title">Custom Session Naming</string>
    <string name="help_session_naming_desc">Long-press Start or Start All (&gt;0.5s) to name a session using quick preset chips while timing. You can also rename any session retroactively in the Detail View.</string>
    <string name="help_precision_sort_title">Precision &amp; Display Settings</string>
    <string name="help_precision_sort_desc">Configure separate running time vs result/lap precision, themes, text scaling, auto-sorting, Keep Screen Awake, and language settings.</string>

