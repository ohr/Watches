    <!-- Help Dialog & Tooltips -->
    <string name="cd_help">Hilfe</string>
    <string name="dialog_help_title">Hilfe &amp; Kurzanleitung</string>
    <string name="help_vol_keys_title">Hardware-Lautstärketasten</string>
    <string name="help_vol_keys_desc">Lauter = Alle starten / Rundenzeit für fokussierte Stoppuhr\nLeiser = Fokussierte Stoppuhr stoppen / Alle zurücksetzen, wenn gestoppt</string>
    <string name="help_hardware_keys_title">Hardware-Lautstärketasten</string>
    <string name="help_hardware_keys_desc">Lauter = Alle starten / Rundenzeit für fokussierte Stoppuhr\nLeiser = Fokussierte Stoppuhr stoppen / Alle zurücksetzen, wenn gestoppt</string>
    <string name="help_reset_title">Zurücksetzen-Steuerung</string>
    <string name="help_reset_desc">Kurz drücken (&lt;0,3s): Setzt die Anzeigezeit auf 0 zurück und bereitet einen neuen Lauf vor (Lauf 1, Lauf 2, …).\nLange drücken (&gt;0,3s): Löscht alle Läufe und den Rundenverlauf vollständig.</string>
    <string name="help_reset_button_title">Zurücksetzen-Steuerung</string>
    <string name="help_reset_button_desc">Kurz drücken (&lt;0,3s): Setzt die Anzeigezeit auf 0 zurück und bereitet einen neuen Lauf vor (Lauf 1, Lauf 2, …).\nLange drücken (&gt;0,3s): Löscht alle Läufe und den Rundenverlauf vollständig.</string>
    <string name="help_pace_trend_title">Rundentrend-Anzeige</string>
    <string name="help_pace_trend_desc">Grün ▼ zeigt eine schnellere Runde als die vorherige an, Rot ▲ eine langsamere Runde.</string>
    <string name="help_roster_title">Gespeicherte Athleten-Liste</string>
    <string name="help_roster_desc">Beim Bearbeiten von Namen werden diese automatisch in Ihrer Liste gespeichert. Im Dialog \'Mehrere Uhren\' können Sie Athleten aus der Liste auswählen.</string>
    <string name="help_csv_title">Export &amp; CSV-Tabellen</string>
    <string name="help_csv_desc">Teilen Sie Ergebnisse als Text für Messenger oder als .csv-Tabelle für Excel und Google Sheets.</string>
    <string name="help_details_title">Detailansicht &amp; Export</string>
    <string name="help_details_desc">Tippen Sie auf das Info-Symbol einer Stoppuhr, um den Verlauf der Läufe anzuzeigen und Einzelergebnisse zu exportieren. Gestoppte Stoppuhren bieten in der Detailansicht die Schaltfläche \"Läufe löschen\", um den Verlauf zu leeren.</string>
    <string name="help_detail_view_title">Detailansicht &amp; Export</string>
    <string name="help_detail_view_desc">Tippen Sie auf das Info-Symbol einer Stoppuhr, um den Verlauf der Läufe anzuzeigen und Einzelergebnisse zu exportieren. Gestoppte Stoppuhren bieten in der Detailansicht die Schaltfläche \"Läufe löschen\", um den Verlauf zu leeren.</string>
    <string name="help_settings_title">Präzisions- &amp; Anzeige-Einstellungen</string>
    <string name="help_settings_desc">Konfigurieren Sie getrennte Genauigkeit für laufende Zeit und Ergebnisse/Runden, Themes, Textskalierung, automatische Sortierung, Bildschirm anlassen und Spracheinstellungen.</string>
    <string name="help_session_naming_title">Sessionen benennen</string>
    <string name="help_session_naming_desc">Drücken Sie lange auf Start oder Starten (&gt;0,3s), um eine Session mit Schnellauswahl-Chips zu benennen. Sie können Sessionen auch nachträglich in den Details umbenennen.</string>
    <string name="help_precision_sort_title">Präzisions- &amp; Anzeige-Einstellungen</string>
    <string name="help_precision_sort_desc">Konfigurieren Sie getrennte Genauigkeit für laufende Zeit und Ergebnisse/Runden, Themes, Textskalierung, automatische Sortierung, Bildschirm anlassen und Spracheinstellungen.</string>

