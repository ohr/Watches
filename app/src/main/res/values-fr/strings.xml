    <!-- Help Dialog & Tooltips -->
    <string name="cd_help">Aide</string>
    <string name="dialog_help_title">Aide &amp; Guide rapide</string>
    <string name="help_vol_keys_title">Boutons de volume physiques</string>
    <string name="help_vol_keys_desc">Volume+ = Tout démarrer / Temps au tour pour le chrono ciblé\nVolume- = Arrêter le chrono ciblé / Tout réinitialiser une fois arrêté</string>
    <string name="help_hardware_keys_title">Boutons de volume physiques</string>
    <string name="help_hardware_keys_desc">Volume+ = Tout démarrer / Temps au tour pour le chrono ciblé\nVolume- = Arrêter le chrono ciblé / Tout réinitialiser une fois arrêté</string>
    <string name="help_reset_title">Contrôles du bouton Réinitialiser</string>
    <string name="help_reset_desc">Appui court (&lt;0,3s) : Réinitialise le temps affiché à 0 et prépare une nouvelle session de course (Course 1, Course 2, …).\nAppui long (&gt;0,3s) : Effectue une suppression complète de toutes les sessions de course et de l\'historique des tours.</string>
    <string name="help_reset_button_title">Contrôles du bouton Réinitialiser</string>
    <string name="help_reset_button_desc">Appui court (&lt;0,3s) : Réinitialise le temps affiché à 0 et prépare une nouvelle session de course (Course 1, Course 2, …).\nAppui long (&gt;0,3s) : Effectue une suppression complète de toutes les sessions de course et de l\'historique des tours.</string>
    <string name="help_pace_trend_title">Indicateur de tendance d\'allure</string>
    <string name="help_pace_trend_desc">Vert ▼ indique un tour plus rapide que le précédent, Rouge ▲ indique un tour plus lent.</string>
    <string name="help_roster_title">Liste d\'athlètes enregistrés</string>
    <string name="help_roster_desc">La modification des noms enregistre automatiquement les athlètes. Dans le menu d\'ajout par lot, cochez les athlètes pour créer leurs chronos.</string>
    <string name="help_csv_title">Exportation &amp; Fichiers CSV</string>
    <string name="help_csv_desc">Partagez les résultats sous forme de résumé texte ou de fichier .csv pour Excel et Google Sheets.</string>
    <string name="help_details_title">Vue détaillée &amp; Export</string>
    <string name="help_details_desc">Appuyez sur l\'icône info d\'un chronomètre pour consulter l\'historique des sessions et exporter les résultats individuels. Les chronomètres arrêtés disposent d\'un bouton \"Supprimer les sessions\" dans la vue détaillée pour effacer l\'historique.</string>
    <string name="help_detail_view_title">Vue détaillée &amp; Export</string>
    <string name="help_detail_view_desc">Appuyez sur l\'icône info d\'un chronomètre pour consulter l\'historique des sessions et exporter les résultats individuels. Les chronomètres arrêtés disposent d\'un bouton \"Supprimer les sessions\" dans la vue détaillée pour effacer l\'historique.</string>
    <string name="help_settings_title">Paramètres de précision &amp; d\'affichage</string>
    <string name="help_settings_desc">Configurez séparément la précision du temps en cours et des résultats/tours, les thèmes, la taille du texte, le tri automatique, le maintien de l\'écran allumé et la langue.</string>
    <string name="help_session_naming_title">Nommer les sessions</string>
    <string name="help_session_naming_desc">Appuyez longuement sur Démarrer (&gt;0,3s) pour nommer une session avec des puces rapides. Vous pouvez aussi renommer les sessions dans les détails.</string>
    <string name="help_precision_sort_title">Paramètres de précision &amp; d\'affichage</string>
    <string name="help_precision_sort_desc">Configurez séparément la précision du temps en cours et des résultats/tours, les thèmes, la taille du texte, le tri automatique, le maintien de l\'écran allumé et la langue.</string>

